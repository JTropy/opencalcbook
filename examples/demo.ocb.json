          "dataType": "float",
          "precision": -1
        }
      ],
      "codes": []
    },
    {
      "name": "梯形面积",
      "description": "梯形面积 = (上底 + 下底) × 高 / 2",
      "expr": "(a+b)*h/2",
      "unit": "m2",
      "precision": 4,
      "catalog": "几何",
      "library": true,
      "params": [
        {
          "name": "a",
          "description": "上底",
          "unit": "m",
          "dataType": "float",
          "precision": -1
        },
        {
          "name": "b",
          "description": "下底",
          "unit": "m",
          "dataType": "float",
          "precision": -1
        },
        {
          "name": "h",
          "description": "高",
          "unit": "m",
          "dataType": "float",
          "precision": -1
        }
      ],
      "codes": []
    },
    {
      "name": "圆形面积",
      "description": "圆形面积 = π × r²",
      "expr": "PI()*r^2",
      "unit": "m2",
      "precision": 4,
      "catalog": "几何",
      "library": true,
      "params": [
        {
          "name": "r",
          "description": "半径",
          "unit": "m",
          "dataType": "float",
          "precision": -1
        }
      ],
      "codes": []
    },
    {
      "name": "环形面积",
      "description": "环形面积 = π × (外半径² − 内半径²)",
      "expr": "PI()*(R^2-r^2)",
      "unit": "m2",
      "precision": 4,
      "catalog": "几何",
      "library": true,
      "params": [
        {
          "name": "R",
          "description": "外半径",
          "unit": "m",
          "dataType": "float",
          "precision": -1
