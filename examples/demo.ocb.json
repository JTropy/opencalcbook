          "name": "r",
          "description": "内半径",
          "unit": "m",
          "dataType": "float",
          "precision": -1
        }
      ],
      "codes": []
    },
    {
      "name": "扇形面积",
      "description": "扇形面积 = π × r² × 圆心角 / 360",
      "expr": "PI()*r^2*angle/360",
      "unit": "m2",
      "precision": 4,
      "catalog": "几何",
      "library": true,
      "params": [
        {
          "name": "r",
          "description": "半径",
          "unit": "m",
